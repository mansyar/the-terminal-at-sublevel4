; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="The Terminal at Sub-Level 4"
config/description="Retro-terminal horror: run the graveyard-shift console for Facility Boreas and decide who lives."
config/version="0.1.0"
run/main_scene=""
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

[display]

window/size/viewport_width=1024
window/size/viewport_height=768
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

environment/defaults/default_clear_color=Color(0.02, 0.05, 0.02, 1)
